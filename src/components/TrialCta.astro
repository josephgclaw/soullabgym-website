---
/**
 * <TrialCta /> — the closing funnel block used on the timetable and prices pages.
 * Pink band, one message, one button, two quiet links.
 */
---
<section class="relative bg-slg-pink overflow-hidden py-20 sm:py-24">
  <div class="absolute inset-0 pointer-events-none opacity-[0.08]" aria-hidden="true">
    <svg class="absolute -right-24 -top-24 w-[520px] h-[520px] text-white" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="100" cy="100" r="88" /><circle cx="100" cy="100" r="64" /><circle cx="100" cy="100" r="40" />
      <path d="M100 12v176M12 100h176M38 38l124 124M162 38L38 162" />
    </svg>
  </div>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
    <p class="text-white/85 text-xs font-bold uppercase tracking-[0.22em] mb-4">New members</p>
    <h2 class="font-display text-5xl sm:text-7xl uppercase text-white leading-[.92] mb-5">
      Free trial<br class="sm:hidden" /> + free gear pack
    </h2>
    <p class="text-white/90 text-lg max-w-xl mx-auto mb-9 leading-relaxed">
      Train for free, keep the gear. No contracts, no pressure — just turn up and give it a go.
    </p>
    <a
      href="https://soullabgymoffer.com/offer"
      class="inline-block bg-slg-dark hover:bg-black text-white font-bold text-sm uppercase tracking-widest px-10 py-5 rounded-full transition-all hover:-translate-y-0.5 shadow-[0_14px_40px_-12px_rgba(0,0,0,.6)]"
    >
      Claim Your Free Trial →
    </a>
    <p class="text-white/75 text-sm mt-7">
      Questions? <a href="/contact" class="underline underline-offset-2 font-semibold text-white">Contact us</a> or <a href="/private-training" class="underline underline-offset-2 font-semibold text-white">book private training</a>.
    </p>
  </div>
</section>
