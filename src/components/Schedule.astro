---
/**
 * <Schedule />
 * Day-tabbed class timetable. All six days render at build time (good for SEO,
 * works without JS showing Monday); a small script switches days, opens on today,
 * and supports swipe, arrow keys and the prev/next arrows.
 *
 * Usage: import Schedule from '../components/Schedule.astro'; <Schedule />
 * Data: src/data/schedule.ts
 */
import { DAYS, LEVELS, SCHEDULE, formatTime, groupByTime } from '../data/schedule';

interface Props { class?: string }
const { class: className } = Astro.props;

// Sunday is closed, so tabs run Monday–Saturday.
const OPEN_DAYS = DAYS.slice(0, 6);
---

<div class:list={['sl-schedule', className]} data-sl-schedule aria-label="Class timetable">
  <div class="sl-tabs" role="tablist" aria-label="Day">
    {OPEN_DAYS.map((d, i) => (
      <button
        class="sl-tab" role="tab" type="button"
        id={`sl-tab-${i}`} aria-controls={`sl-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'} data-i={i}
      >{d}<span class="today" hidden aria-hidden="true"></span></button>
    ))}
  </div>

  <div class="sl-stage">
    <button type="button" class="sl-arrow sl-arrow-prev" data-go="-1" aria-label="Previous day">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    {OPEN_DAYS.map((d, i) => {
      const list = SCHEDULE[d];
      const groups = groupByTime(list);
      const count = list.length === 1 ? '1 session scheduled' : `${list.length} sessions scheduled`;
      return (
        <section class="sl-card" id={`sl-panel-${i}`} role="tabpanel" aria-labelledby={`sl-tab-${i}`} hidden={i !== 0} data-i={i}>
          <header class="sl-head">
            <h3>{d}<span class="today" hidden>Today</span></h3>
            <span>{count}</span>
          </header>
          <ol class="sl-rows">
            {groups.map((g) => {
              const f = formatTime(g.time);
              return (
                <li class="sl-row">
                  <time class="sl-time" datetime={g.time}>{f.time}<small>{f.period}</small></time>
                  <div class="sl-pills">
                    {g.items.map((s) => (
                      <span class={`sl-pill ${LEVELS[s.level].cls}`}>
                        {s.name}{s.note && <i>{s.note}</i>}
                      </span>
                    ))}
                  </div>
                  <a class="sl-book" href="/book-trial" aria-label={`Book a trial class at ${f.time}${f.period} on ${d}`}>Book a trial<span aria-hidden="true"> →</span></a>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}

    <button type="button" class="sl-arrow sl-arrow-next" data-go="1" aria-label="Next day">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  <div class="sl-dots" aria-hidden="true">
    {OPEN_DAYS.map((_, i) => <button type="button" class="sl-dot" data-i={i} tabindex="-1"></button>)}
  </div>

  <div class="sl-foot">
    <p class="sl-note">Closed Sundays. Kids classes run Monday to Saturday — see <a href="/book-trial">Book a Trial</a> to reserve a spot.</p>
    <ul class="sl-legend">
      {Object.values(LEVELS).map((l) => <li class={l.cls}><i></i>{l.label}</li>)}
    </ul>
  </div>
</div>

<script>
  const N = 6; // Monday–Saturday
  const DAY_NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  document.querySelectorAll<HTMLElement>('[data-sl-schedule]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.sl-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.sl-card'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.sl-dot'));
    const jsDay = new Date().getDay(); // Sun=0
    const todayIdx = jsDay === 0 ? -1 : jsDay - 1; // Mon=0 … Sat=5, Sunday → none
    let idx = 0;

    if (todayIdx >= 0) {
      tabs[todayIdx].querySelector<HTMLElement>('.today')!.hidden = false;
      panels[todayIdx].querySelector<HTMLElement>('.today')!.hidden = false;
    }

    function select(n: number, opts: { animate?: boolean; focus?: boolean } = {}) {
      const next = ((n % N) + N) % N;
      const dir = next > idx ? 'from-right' : 'from-left';
      if (next === idx && opts.animate) return;
      idx = next;

      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
      dots.forEach((d, i) => d.classList.toggle('is-on', i === idx));
      panels.forEach((p, i) => {
        p.classList.remove('from-right', 'from-left');
        p.hidden = i !== idx;
        if (i === idx && opts.animate) p.classList.add(dir);
      });
      tabs[idx].scrollIntoView({ block: 'nearest', inline: 'center', behavior: opts.animate ? 'smooth' : 'auto' });
      if (opts.focus) tabs[idx].focus();
    }

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-i].sl-tab,[data-i].sl-dot,[data-go]');
      if (!t) return;
      if (t.dataset.i != null) select(+t.dataset.i, { animate: true });
      else select(idx + +t.dataset.go!, { animate: true });
    });
    root.addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).closest('.sl-tabs')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); select(idx + 1, { animate: true, focus: true }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); select(idx - 1, { animate: true, focus: true }); }
    });
    let sx: number | null = null;
    root.addEventListener('pointerdown', (e) => { if ((e.target as HTMLElement).closest('.sl-card')) sx = e.clientX; });
    root.addEventListener('pointerup', (e) => {
      if (sx == null) return;
      const dx = e.clientX - sx; sx = null;
      if (Math.abs(dx) > 48) select(idx + (dx < 0 ? 1 : -1), { animate: true });
    });

    select(Math.max(todayIdx, 0)); // open on today (Monday on Sundays), no animation
    void DAY_NAMES;
  });
</script>

<style>
  .sl-schedule {
    /* Soul Lab Gym brand colours */
    --sl-text: #f5efe7;
    --sl-muted: #a39c94;
    --sl-line: rgba(255, 255, 255, 0.08);
    --sl-accent: #EC4899;      /* slg-pink */
    --sl-glow: rgba(236, 72, 153, 0.35);
    --lv-kids: #6cbcf5;  --lv-kids-soft: rgba(108, 188, 245, 0.12);
    --lv-all: #4fd9ab;   --lv-all-soft: rgba(79, 217, 171, 0.12);
    --lv-int: #f5a94a;   --lv-int-soft: rgba(245, 169, 74, 0.12);
    --lv-fig: #f2554f;   --lv-fig-soft: rgba(242, 85, 79, 0.12);
    position: relative; max-width: 960px; margin: 0 auto; color: var(--sl-text); font-family: inherit;
  }

  /* ----- Day tabs ----- */
  .sl-tabs { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; padding: 4px 2px 18px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .sl-tabs::-webkit-scrollbar { display: none; }
  .sl-tab {
    flex: 0 0 auto; scroll-snap-align: start; display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--sl-line); background: rgba(255, 255, 255, 0.04); color: #d8d2cb;
    border-radius: 999px; padding: 9px 18px; font: inherit; font-weight: 600; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .sl-tab:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
  .sl-tab[aria-selected="true"] { background: var(--sl-accent); color: #fff; border-color: var(--sl-accent); box-shadow: 0 0 0 1px rgba(236,72,153,.4), 0 6px 24px var(--sl-glow); }
  .sl-tab .today { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .sl-tab .today[hidden] { display: none; }
  .sl-tab:focus-visible, .sl-arrow:focus-visible { outline: 2px solid var(--sl-accent); outline-offset: 2px; }

  /* ----- Day card ----- */
  .sl-stage { position: relative; }
  .sl-card {
    position: relative; border-radius: 18px; padding: 18px 18px 22px; min-height: 260px; touch-action: pan-y;
    background: linear-gradient(180deg, rgba(236, 72, 153, 0.11) 0%, rgba(236, 72, 153, 0.03) 22%, rgba(255, 255, 255, 0.015) 100%), #121013;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 80px -40px rgba(236, 72, 153, 0.25), 0 20px 50px -30px rgba(0, 0, 0, 0.8);
  }
  .sl-card[hidden] { display: none; }
  .sl-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 4px 16px; }
  .sl-head h3 { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .sl-head h3 .today { font-size: 10px; letter-spacing: 0.1em; background: var(--sl-accent); color: #fff; border-radius: 999px; padding: 3px 8px; }
  .sl-head h3 .today[hidden] { display: none; }
  .sl-head > span { color: var(--sl-muted); font-size: 12px; white-space: nowrap; }

  .sl-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sl-row {
    display: grid; grid-template-columns: 76px 1fr; gap: 10px; align-items: center;
    padding: 9px 14px; border-radius: 11px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.15s;
  }
  .sl-row:hover { background: rgba(255, 255, 255, 0.065); }
  .sl-time { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 14px; letter-spacing: 0.02em; white-space: nowrap; }
  .sl-time small { font-size: 11px; font-weight: 600; color: var(--sl-muted); margin-left: 1px; }
  .sl-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .sl-pill {
    display: inline-flex; align-items: center; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--c); background: var(--cs);
    color: #f3eee8; font-size: 12px; font-weight: 600; line-height: 1.2; white-space: nowrap;
  }
  .sl-pill i { font-style: normal; font-weight: 500; color: var(--c); }
  .sl-pill i::before { content: "·"; margin: 0 6px; color: rgba(255,255,255,.35); }
  .sl-book { display: none; }
  .lv-kids { --c: var(--lv-kids); --cs: var(--lv-kids-soft); }
  .lv-all  { --c: var(--lv-all);  --cs: var(--lv-all-soft); }
  .lv-int  { --c: var(--lv-int);  --cs: var(--lv-int-soft); }
  .lv-fig  { --c: var(--lv-fig);  --cs: var(--lv-fig-soft); }

  /* ----- Arrows ----- */
  .sl-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 38px; height: 38px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    background: #17141a; color: #e9e3dc; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 8px 24px rgba(0,0,0,.5);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .sl-arrow svg { width: 18px; height: 18px; }
  .sl-arrow:hover { background: var(--sl-accent); border-color: var(--sl-accent); color: #fff; }
  .sl-arrow-prev { left: -14px; }
  .sl-arrow-next { right: -14px; }
  @media (min-width: 1100px) { .sl-arrow-prev { left: -58px; } .sl-arrow-next { right: -58px; } }

  /* ----- Dots ----- */
  .sl-dots { position: relative; display: flex; justify-content: center; gap: 10px; padding: 18px 0 6px; }
  .sl-dots::before { content: ""; position: absolute; left: 15%; right: 15%; top: 50%; height: 1px; background: linear-gradient(90deg, transparent, rgba(236,72,153,.35) 20%, rgba(236,72,153,.35) 80%, transparent); pointer-events: none; }
  .sl-dot { position: relative; width: 7px; height: 7px; border-radius: 50%; border: 0; padding: 0; background: rgba(255,255,255,.22); cursor: pointer; transition: transform .15s, background .15s; }
  .sl-dot.is-on { background: var(--sl-accent); transform: scale(1.5); box-shadow: 0 0 10px var(--sl-glow); }

  /* ----- Footer ----- */
  .sl-foot { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 10px; text-align: center; }
  .sl-note { margin: 0; font-size: 13px; color: var(--sl-muted); line-height: 1.5; }
  .sl-note a { color: var(--sl-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .sl-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; list-style: none; padding: 0; margin: 0; font-size: 12px; color: var(--sl-muted); }
  .sl-legend li { display: flex; align-items: center; gap: 7px; }
  .sl-legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }

  @media (min-width: 720px) {
    .sl-card { padding: 22px 24px 26px; }
    .sl-row { grid-template-columns: 90px 1fr auto; padding: 11px 16px; }
    .sl-tabs { justify-content: center; }
    .sl-book { display: inline-block; font-size: 12px; font-weight: 600; color: rgba(255,255,255,.38); white-space: nowrap; padding: 4px 2px; transition: color .15s; }
    .sl-row:hover .sl-book, .sl-book:focus-visible { color: var(--sl-accent); }
  }

  @keyframes sl-in-r { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }
  @keyframes sl-in-l { from { opacity: 0; transform: translateX(-18px); } to { opacity: 1; transform: none; } }
  .sl-card.from-right { animation: sl-in-r 0.22s ease-out; }
  .sl-card.from-left  { animation: sl-in-l 0.22s ease-out; }
  @media (prefers-reduced-motion: reduce) { .sl-card { animation: none !important; } .sl-tab, .sl-dot { transition: none; } }
</style>
