---
/**
 * <Schedule />
 * Day-tabbed class timetable. All seven days render at build time (good for SEO,
 * works without JS showing Monday); a small script switches days, opens on today,
 * and supports swipe + arrow keys.
 *
 * Usage: import Schedule from '../components/Schedule.astro'; <Schedule />
 * Data: src/data/schedule.ts
 */
import { DAYS, LEVELS, SCHEDULE, formatTime, groupByTime, nextDayWithClasses } from '../data/schedule';

interface Props { class?: string }
const { class: className } = Astro.props;
---

<div class:list={['sl-schedule', className]} data-sl-schedule aria-label="Class timetable">
  <div class="sl-tabs" role="tablist" aria-label="Day">
    {DAYS.map((d, i) => (
      <button
        class="sl-tab" role="tab" type="button"
        id={`sl-tab-${i}`} aria-controls={`sl-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'} data-i={i}
      >{d}<span class="today" hidden aria-hidden="true"></span></button>
    ))}
  </div>

  {DAYS.map((d, i) => {
    const list = SCHEDULE[d];
    const groups = groupByTime(list);
    const count = list.length === 0 ? 'No classes' : list.length === 1 ? '1 class' : `${list.length} classes`;
    const next = nextDayWithClasses(i);
    return (
      <section class="sl-card" id={`sl-panel-${i}`} role="tabpanel" aria-labelledby={`sl-tab-${i}`} hidden={i !== 0} data-i={i}>
        <header class="sl-head"><h3>{d}</h3><span>{count}</span></header>
        {groups.length ? (
          <ol class="sl-rows">
            {groups.map((g) => {
              const f = formatTime(g.time);
              return (
                <li class="sl-row">
                  <time class="sl-time" datetime={g.time}>{f.time}<small>{f.period}</small></time>
                  <div class="sl-pills">
                    {g.items.map((s) => (
                      <span class={`sl-pill ${LEVELS[s.level].cls}`}>
                        <b>{s.name}</b>{s.note && <i>{s.note}</i>}
                      </span>
                    ))}
                  </div>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="sl-empty">No classes on {d}.{next && ` Next session is ${next}.`}</p>
        )}
      </section>
    );
  })}

  <nav class="sl-pager" aria-label="Change day">
    <button type="button" data-go="-1"><span aria-hidden="true">‹</span> <span data-prev>{DAYS[6]}</span></button>
    <button type="button" data-go="1"><span data-next>{DAYS[1]}</span> <span aria-hidden="true">›</span></button>
  </nav>

  <ul class="sl-legend">
    {Object.values(LEVELS).map((l) => <li class={l.cls}><i></i>{l.label}</li>)}
  </ul>
</div>

<script>
  const DAY_NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

  document.querySelectorAll<HTMLElement>('[data-sl-schedule]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.sl-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.sl-card'));
    const prevLabel = root.querySelector<HTMLElement>('[data-prev]')!;
    const nextLabel = root.querySelector<HTMLElement>('[data-next]')!;
    const todayIdx = (new Date().getDay() + 6) % 7; // Mon=0 … Sun=6
    let idx = 0;

    tabs[todayIdx].querySelector<HTMLElement>('.today')!.hidden = false;

    function select(n: number, opts: { animate?: boolean; focus?: boolean } = {}) {
      const dir = n > idx ? 'from-right' : 'from-left';
      const next = ((n % 7) + 7) % 7;
      if (next === idx && opts.animate) return;
      idx = next;

      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
      panels.forEach((p, i) => {
        p.classList.remove('from-right', 'from-left');
        p.hidden = i !== idx;
        if (i === idx && opts.animate) p.classList.add(dir);
      });
      prevLabel.textContent = DAY_NAMES[(idx + 6) % 7];
      nextLabel.textContent = DAY_NAMES[(idx + 1) % 7];
      tabs[idx].scrollIntoView({ block: 'nearest', inline: 'center', behavior: opts.animate ? 'smooth' : 'auto' });
      if (opts.focus) tabs[idx].focus();
    }

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-i].sl-tab,[data-go]');
      if (!t) return;
      if (t.dataset.i != null) select(+t.dataset.i, { animate: true });
      else select(idx + +t.dataset.go!, { animate: true });
    });
    root.addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).closest('.sl-tabs')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); select(idx + 1, { animate: true, focus: true }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); select(idx - 1, { animate: true, focus: true }); }
    });
    let sx: number | null = null;
    root.addEventListener('pointerdown', (e) => { if ((e.target as HTMLElement).closest('.sl-card')) sx = e.clientX; });
    root.addEventListener('pointerup', (e) => {
      if (sx == null) return;
      const dx = e.clientX - sx; sx = null;
      if (Math.abs(dx) > 48) select(idx + (dx < 0 ? 1 : -1), { animate: true });
    });

    select(todayIdx); // open on today, no animation
  });
</script>

<style>
  .sl-schedule {
    /* Soul Lab Gym brand colours */
    --sl-bg: #0f0d0c;
    --sl-text: #f5efe7;
    --sl-muted: #9c958d;
    --sl-line: rgba(255, 255, 255, 0.08);
    --sl-card: rgba(255, 255, 255, 0.03);
    --sl-accent: #EC4899;      /* slg-pink */
    --sl-accent-ink: #1a0a10;  /* near-black — 6:1 contrast on #EC4899 */
    --sl-glow: rgba(236, 72, 153, 0.22);
    --lv-kids: #5fb6f7;  --lv-kids-soft: rgba(95, 182, 247, 0.14);
    --lv-all: #3fd4a4;   --lv-all-soft: rgba(63, 212, 164, 0.14);
    --lv-int: #f39a3b;   --lv-int-soft: rgba(243, 154, 59, 0.14);
    --lv-fig: #f2554f;   --lv-fig-soft: rgba(242, 85, 79, 0.14);
    position: relative; isolation: isolate; overflow: hidden;
    max-width: 560px; margin: 0 auto; padding: 22px 16px 26px;
    background: var(--sl-bg); color: var(--sl-text); border-radius: 28px;
    font-family: inherit;
  }
  .sl-schedule::before {
    content: ""; position: absolute; left: -10%; right: -10%; top: -30%; height: 60%; z-index: -1; pointer-events: none;
    background: radial-gradient(55% 60% at 50% 30%, var(--sl-glow), transparent 72%);
  }

  .sl-tabs { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; padding: 4px 2px 14px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .sl-tabs::-webkit-scrollbar { display: none; }
  .sl-tab {
    flex: 0 0 auto; scroll-snap-align: start; display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--sl-line); background: rgba(255, 255, 255, 0.04); color: var(--sl-muted);
    border-radius: 999px; padding: 10px 18px; font: inherit; font-weight: 600; font-size: 14px; letter-spacing: 0.01em; cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .sl-tab[aria-selected="true"] { background: var(--sl-accent); color: var(--sl-accent-ink); border-color: transparent; box-shadow: 0 0 26px var(--sl-glow); }
  .sl-tab .today { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.85; }
  .sl-tab .today[hidden] { display: none; }
  .sl-tab:focus-visible, .sl-pager button:focus-visible { outline: 2px solid var(--sl-accent); outline-offset: 2px; }

  .sl-card { border: 1px solid var(--sl-line); background: var(--sl-card); border-radius: 20px; padding: 6px 18px 8px; touch-action: pan-y; }
  .sl-card[hidden] { display: none; }
  .sl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 14px 0 12px; }
  .sl-head h3 { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.015em; font-family: 'Bebas Neue', sans-serif; }
  .sl-head span { color: var(--sl-muted); font-size: 13px; white-space: nowrap; }

  .sl-rows { list-style: none; margin: 0; padding: 0; }
  .sl-row { display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: start; padding: 14px 0; border-top: 1px solid var(--sl-line); }
  .sl-time { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 17px; line-height: 1.15; padding-top: 7px; }
  .sl-time small { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; color: var(--sl-muted); margin-top: 2px; }
  .sl-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .sl-pill { display: inline-flex; flex-direction: column; padding: 8px 14px 9px; border-radius: 16px; border: 1px solid var(--c); background: var(--cs); line-height: 1.2; }
  .sl-pill b { font-weight: 600; font-size: 15px; }
  .sl-pill i { font-style: normal; font-size: 11.5px; font-weight: 600; color: var(--c); margin-top: 3px; }
  .lv-kids { --c: var(--lv-kids); --cs: var(--lv-kids-soft); }
  .lv-all  { --c: var(--lv-all);  --cs: var(--lv-all-soft); }
  .lv-int  { --c: var(--lv-int);  --cs: var(--lv-int-soft); }
  .lv-fig  { --c: var(--lv-fig);  --cs: var(--lv-fig-soft); }
  .sl-empty { margin: 0; padding: 26px 0 22px; border-top: 1px solid var(--sl-line); color: var(--sl-muted); font-size: 15px; line-height: 1.4; }

  .sl-pager { display: flex; justify-content: space-between; margin-top: 10px; }
  .sl-pager button { background: none; border: 0; color: var(--sl-muted); font: inherit; font-size: 14px; font-weight: 600; padding: 10px 6px; cursor: pointer; border-radius: 8px; }
  .sl-pager button:hover { color: var(--sl-text); }

  .sl-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; padding: 0; margin: 14px 6px 0; font-size: 12.5px; color: var(--sl-muted); }
  .sl-legend li { display: flex; align-items: center; gap: 7px; }
  .sl-legend i { width: 9px; height: 9px; border-radius: 50%; background: var(--c); }

  @keyframes sl-in-r { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }
  @keyframes sl-in-l { from { opacity: 0; transform: translateX(-18px); } to { opacity: 1; transform: none; } }
  .sl-card.from-right { animation: sl-in-r 0.22s ease-out; }
  .sl-card.from-left  { animation: sl-in-l 0.22s ease-out; }
  @media (prefers-reduced-motion: reduce) { .sl-card { animation: none !important; } .sl-tab { transition: none; } }
</style>
