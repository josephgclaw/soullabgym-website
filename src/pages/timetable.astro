---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Schedule from '../components/Schedule.astro';
import PageHero from '../components/PageHero.astro';
import TrialCta from '../components/TrialCta.astro';
---

<Layout
  title="Class Timetable — Soul Lab Gym"
  description="Soul Lab Gym class timetable. Muay Thai, boxing and kids classes in Townsville, six days a week. Find a class and book a free trial."
  theme="dark"
>
  <Nav />

  <PageHero
    titleLines={['Class', 'Timetable']}
    eyebrow="Monday to Saturday · Townsville"
    image="/photos/adult-large-class-group.jpg"
    imageAlt="Adults Muay Thai class at Soul Lab Gym"
    imagePosition="center 30%"
  />

  <!-- TIMETABLE -->
  <section class="bg-stars bg-slg-dark py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10" data-reveal>
        <p class="text-slg-pink text-xs font-bold uppercase tracking-[0.22em] mb-3">Pick a day</p>
        <h2 class="font-display text-4xl sm:text-5xl uppercase text-white leading-none mb-4">Find your class</h2>
        <p class="text-white/70 text-base sm:text-lg leading-relaxed">
          Kids from 3:45pm, adults from 6am. Every class is coached, structured and open to beginners unless marked otherwise.
        </p>
      </div>

      <div data-reveal style="transition-delay:120ms">
        <Schedule />
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-12" data-reveal>
        <a href="https://soullabgymoffer.com/offer" class="btn-pink">Claim Free Trial + Gear Pack</a>
        <a href="/prices" class="btn-ghost">See Membership Prices</a>
      </div>
    </div>
  </section>

  <!-- CLASS LEVELS -->
  <section class="bg-slg-dark border-t border-white/10 py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-slg-pink text-xs font-bold uppercase tracking-[0.22em] mb-3">How classes work</p>
        <h2 class="font-display text-4xl sm:text-5xl uppercase text-white leading-none">Class levels</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { tag: 'Level 1', title: 'All Levels', body: "Your first session or your five-hundredth. Coaches scale every drill to where you're at, so you just have to show up.", color: 'var(--lv-all, #4fd9ab)' },
          { tag: 'Level 2', title: 'Intermediate', body: 'Technique-driven sessions with pad rounds, partner drills and conditioning. For students who know the basics and want ring IQ.', color: '#f5a94a' },
          { tag: 'Level 3 · Invite only', title: 'Fighters / Advanced', body: 'Invitation-only blocks for fighters and advanced students. Sparring, clinch and fight-camp preparation.', color: '#f2554f' },
        ].map((l, i) => (
          <div class="level-card" data-reveal style={`transition-delay:${i * 90}ms; --lc:${l.color}`}>
            <span class="level-tag">{l.tag}</span>
            <h3 class="text-xl font-bold text-white mt-4 mb-2">{l.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{l.body}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-white/55 text-sm mt-8" data-reveal>
        Kids classes: Junior Kids 4–6 yrs · Senior Kids 7–10 yrs · Teens 11–15 yrs. See <a href="/grading" class="text-slg-pink font-semibold underline underline-offset-2">kids grading</a> for the belt system.
      </p>
    </div>
  </section>

  <TrialCta />

  <Footer />
</Layout>

<style>
  .level-card { position: relative; padding: 28px; border-radius: 16px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); overflow: hidden; transition: border-color .2s, transform .2s; }
  .level-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--lc); }
  .level-card:hover { border-color: rgba(255,255,255,.18); transform: translateY(-2px); }
  .level-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--lc); border: 1px solid color-mix(in srgb, var(--lc) 50%, transparent); border-radius: 999px; padding: 4px 10px; }
</style>
