---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// ── Battle at the Lab 5 — event details. Edit here when anything changes. ──
const EVENT = {
  name: 'Battle at the Lab 5',
  day: 'Saturday',
  dateNum: '7',
  month: 'November',
  dateLong: 'Saturday 7 November 2026',
  doors: '2PM',
  weighIn: '2:30PM',
  firstFight: '3PM',
  address: 'Soul Lab Gym · 2/70 Ingham Rd, West End',
};

// Registration form on/off switch. Set to false to close sign-ups (page stays up, form is replaced by a notice).
const REGISTRATIONS_OPEN = true;

const TICKETS = [
  { label: 'Kids', price: '$10' },
  { label: 'Adults', price: '$20', featured: true },
  { label: 'Family', price: '$40', note: '2 adults + 2 kids' },
];

// Division options on the registration form. `value` is what lands in the sheet's Division column.
const DIVISIONS = [
  { value: 'D class — Exhibition', title: 'D Class', desc: 'Exhibition · no winner' },
  { value: 'C class — Amateur fight', title: 'C Class', desc: 'Amateur fight · winner declared' },
  { value: 'Junior bout (under 13)', title: 'Junior', desc: 'Under 13 · no head contact' },
];

const JUNIOR_RULES = [
  { age: '6–8 yrs', rules: 'Strikes above the waist and below the shoulders only. No elbows. No head contact.', rounds: '3 × 1 min' },
  { age: '8–10 yrs', rules: 'Strikes below the shoulders only. No elbows. No head contact.', rounds: '3 × 1 min' },
  { age: '10–12 yrs', rules: 'Strikes below the shoulders. Elbows allowed. No head contact.', rounds: '3 × 90 sec' },
];

const STRIP = [
  { src: '/photos/batl-teep-headgear.jpg', alt: 'Fighter throwing a teep in headgear at Battle at the Lab 4', pos: 'center 40%' },
  { src: '/photos/batl-fighter-focus.jpg', alt: 'Soul Lab fighter focused in headgear before his bout', pos: 'center 30%' },
  { src: '/photos/batl-teens-high-kick.jpg', alt: 'Teen fighters exchanging kicks in headgear', pos: 'center 35%' },
];
---

<Layout
  title="BATL 5 — Battle at the Lab · Sat 7 November | Soul Lab Gym Townsville"
  description="BATL — Soul Lab Gym's Muay Thai fight series. Battle at the Lab 5: Saturday 7 November, doors 2pm, first fight 3pm. Open to all gyms. D-class exhibition, C-class amateur and junior bouts. Register to fight or grab tickets at the door."
  ogImage="/photos/batl-5-poster.jpg"
  theme="dark"
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@1,800;1,900&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />
  </Fragment>

  <!-- Meta Pixel: fight.soullabgym.com -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2559980727754440');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2559980727754440&ev=PageView&noscript=1"
  /></noscript>

  <Nav />

  <div class="batl">

  <!-- ═════════ HERO (poster) ═════════ -->
  <section class="hero">
    <div class="hero-photo duo" aria-hidden="true">
      <img src="/photos/batl-kick-crowd.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="hero-fade" aria-hidden="true"></div>

    <div class="hero-inner">
      <p class="track text-[11px] sm:text-sm text-batl-bone">Soul Lab Gym presents</p>

      <h1 class="wordmark mt-3 sm:mt-5">
        BATL<span class="sr-only"> — Battle at the Lab 5</span>
      </h1>
      <div class="rule mx-auto"></div>
      <p class="track-wide cond text-lg sm:text-2xl lg:text-3xl text-batl-bone mt-3">Muay Thai Fight Series</p>

      <div class="hero-date">
        <p class="track cond text-2xl sm:text-4xl text-batl-bone">{EVENT.day}</p>
        <p class="date-big cond"><span class="text-batl-blue">{EVENT.dateNum}</span> {EVENT.month}</p>
        <p class="cond times">
          <span>First fight {EVENT.firstFight}</span>
          <span class="bar" aria-hidden="true"></span>
          <span class="text-batl-blue">Doors {EVENT.doors}</span>
        </p>
        <p class="track text-[11px] sm:text-sm text-batl-bone/85 mt-5">Weigh-ins {EVENT.weighIn} · Tickets at the door</p>
        <p class="track text-[11px] sm:text-sm text-batl-bone/85 mt-2">{EVENT.address}</p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-9">
        {REGISTRATIONS_OPEN && <a href="#register" class="bbtn">Register to fight</a>}
        <a href="#tickets" class="bbtn-ghost">Tickets &amp; info</a>
      </div>
      <p class="track text-[10px] sm:text-xs text-batl-blue mt-6">Open to all gyms · Muay Thai only</p>
    </div>
  </section>

  <!-- ═════════ DIVISIONS ═════════ -->
  <section class="sec">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="kicker">Adult competition</p>
        <h2 class="h2">Two divisions</h2>
        <div class="rule-sm"></div>
        <p class="lede">Real ring, real crowd, coached corners. Pick the division that fits where you're at. We match every bout by weight and experience.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <article class="card" data-reveal>
          <div class="photo aspect-[16/10]">
            <img src="/photos/batl-respect-hug.jpg" alt="Two fighters embracing after their bout at Battle at the Lab" style="object-position:center 30%" loading="lazy" />
          </div>
          <div class="p-7 sm:p-9">
            <div class="flex items-end gap-4 mb-5">
              <span class="letter">D</span>
              <div class="pb-2">
                <div class="track text-[10px] text-batl-blue">D Class</div>
                <h3 class="cond text-4xl uppercase text-batl-bone leading-none">Exhibition</h3>
              </div>
            </div>
            <p class="body mb-6">Your first time under the lights, or a chance to get rounds in without the pressure of a result. Controlled, technical, refereed bouts with <strong>no winner declared</strong>.</p>
            <ul class="ticks">
              <li>Built for first-timers and developing fighters</li>
              <li>No winner, no loss: it's about the experience</li>
              <li>Matched by weight and experience</li>
            </ul>
          </div>
        </article>

        <article class="card card-hi" data-reveal style="transition-delay:90ms">
          <div class="photo aspect-[16/10]">
            <img src="/photos/batl-winner-hand-raised.jpg" alt="Referee raising the winner's hand at Battle at the Lab" style="object-position:center 25%" loading="lazy" />
          </div>
          <div class="p-7 sm:p-9">
            <div class="flex items-end gap-4 mb-5">
              <span class="letter">C</span>
              <div class="pb-2">
                <div class="track text-[10px] text-batl-blue">C Class</div>
                <h3 class="cond text-4xl uppercase text-batl-bone leading-none">Amateur Fight</h3>
              </div>
            </div>
            <p class="body mb-6">A proper amateur Muay Thai bout with a <strong>winner declared</strong>. For fighters with some ring time who want a real test of their skills.</p>
            <ul class="ticks">
              <li>Judged bout with a result</li>
              <li>For fighters ready to compete</li>
              <li>Matched by weight and experience</li>
            </ul>
          </div>
        </article>
      </div>

      <p class="text-center text-batl-bone/50 text-sm mt-8 max-w-xl mx-auto">Not sure which division you're ready for? Register anyway and tell us your experience. We'll help you pick.</p>
    </div>
  </section>

  <!-- ═════════ JUNIORS ═════════ -->
  <section id="junior" class="sec sec-alt">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="kicker">Juniors</p>
        <h2 class="h2">Junior bouts</h2>
        <div class="rule-sm"></div>
        <p class="lede">Kids from any gym are welcome. Points-sparring medal matches under age-appropriate rules, in full protective gear. <strong class="text-batl-bone">Kids under 13: no head contact.</strong></p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div data-reveal>
          <div class="panel mb-8 space-y-5">
            <div>
              <h3 class="cond text-2xl uppercase text-batl-bone">No head contact for under-13s</h3>
              <p class="text-batl-bone/60 mt-1 text-sm">Every age group under 13 strikes the body only. Safe, controlled and refereed.</p>
            </div>
            <div>
              <h3 class="cond text-2xl uppercase text-batl-bone">Full protective gear</h3>
              <p class="text-batl-bone/60 mt-1 text-sm">Padding requirements apply by age group.</p>
            </div>
            <div>
              <h3 class="cond text-2xl uppercase text-batl-bone">No combat sports registration needed</h3>
              <p class="text-batl-bone/60 mt-1 text-sm">It's a supported development experience, not a sanctioned fight.</p>
            </div>
          </div>

          <p class="kicker mb-3">Rules by age group</p>
          <div class="overflow-x-auto mb-8">
            <table class="rules">
              <thead><tr><th>Age</th><th>Rules</th><th>Rounds</th></tr></thead>
              <tbody>
                {JUNIOR_RULES.map((row) => (
                  <tr>
                    <td class="cond text-xl text-batl-blue whitespace-nowrap">{row.age}</td>
                    <td>{row.rules}</td>
                    <td class="whitespace-nowrap">{row.rounds}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {REGISTRATIONS_OPEN && <a href="#register" class="bbtn">Sign my kid up</a>}
          <p class="text-batl-bone/40 text-sm mt-4">Questions? Speak to your coach.</p>
        </div>

        <div class="space-y-4" data-reveal style="transition-delay:90ms">
          <div class="photo aspect-[4/3]">
            <img src="/photos/batl-kids-hands-raised.jpg" alt="Two young fighters in chest guards with both hands raised after their junior bout" loading="lazy" />
          </div>
          <div class="photo aspect-[16/9]">
            <img src="/photos/batl-juniors-hands-raised.jpg" alt="Junior fighters with hands raised by the referee at Battle at the Lab" style="object-position:center 30%" loading="lazy" />
          </div>
          <p class="track text-[10px] text-batl-bone/50">Junior bouts · Battle at the Lab 4</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ LAST EVENT STRIP ═════════ -->
  <section class="sec">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="kicker">Last time at the Lab</p>
        <h2 class="h2">BATL 4</h2>
        <div class="rule-sm"></div>
      </header>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {STRIP.map((ph, i) => (
          <div class="photo aspect-[4/5] strip" data-reveal style={`transition-delay:${i * 70}ms`}>
            <img src={ph.src} alt={ph.alt} style={`object-position:${ph.pos}`} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ TICKETS + POSTER ═════════ -->
  <section id="tickets" class="sec sec-alt">
    <div class="wrap grid grid-cols-1 lg:grid-cols-[1.1fr_.9fr] gap-12 items-center">
      <div data-reveal>
        <p class="kicker">Spectators welcome</p>
        <h2 class="h2 text-left">Tickets at the door</h2>
        <div class="rule-sm ml-0"></div>
        <p class="lede text-left mx-0">No booking needed. Cash or card on the night, food and soft drinks available. Under 5s free.</p>

        <div class="grid grid-cols-3 gap-3 sm:gap-4 my-8 max-w-lg">
          {TICKETS.map((t) => (
            <div class={`ticket ${t.featured ? 'ticket-hi' : ''}`}>
              <div class="track text-[10px] text-batl-bone/60 mb-2">{t.label}</div>
              <div class="cond price">{t.price}</div>
              {t.note && <div class="text-[11px] text-batl-bone/50 mt-2 leading-tight">{t.note}</div>}
            </div>
          ))}
        </div>

        <dl class="facts">
          <div><dt>Doors</dt><dd>{EVENT.doors}</dd></div>
          <div><dt>Weigh-ins</dt><dd>{EVENT.weighIn}</dd></div>
          <div><dt>First fight</dt><dd class="text-batl-blue">{EVENT.firstFight}</dd></div>
        </dl>
        <p class="track text-[11px] text-batl-bone/70 mt-5">{EVENT.address}</p>
      </div>

      <figure class="poster" data-reveal style="transition-delay:90ms">
        <img src="/photos/batl-5-poster.jpg" alt="BATL Muay Thai Fight Series poster: Saturday 7 November, first fight 3pm, doors 2pm, Soul Lab Gym, 2/70 Ingham Rd West End" loading="lazy" />
        <figcaption class="mt-4 flex items-center justify-between gap-4">
          <span class="track text-[10px] text-batl-bone/60">Share the poster</span>
          <a href="/photos/batl-5-poster-full.jpg" download="BATL-5-poster.jpg" class="track text-[11px] text-batl-blue hover:text-batl-bone">Download ↓</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═════════ REGISTRATION ═════════ -->
  <section id="register" class="sec">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="sec-head">
        <p class="kicker">Fighters &amp; juniors</p>
        <h2 class="h2">Register to fight</h2>
        <div class="rule-sm"></div>
        <p class="lede">Adults and juniors from any gym. Parents, fill it in with your child's details.</p>
      </header>

      {REGISTRATIONS_OPEN ? (
        <>
          <div id="success-msg" class="hidden panel text-center mb-8" style="border-color:var(--blue)">
            <div class="cond text-4xl uppercase text-batl-bone mb-2">You're on the list!</div>
            <p class="text-batl-bone/70">We'll be in touch with your matchup and fight night details. Get training.</p>
          </div>

          <div id="error-msg" class="hidden bg-red-900/30 border border-red-500 text-batl-bone p-6 mb-8 text-center">
            <p class="font-bold mb-1">Something went wrong.</p>
            <p class="text-batl-bone/70 text-sm">Please try again or contact us at <a href="mailto:soullabgym@gmail.com" class="text-batl-blue underline">soullabgym@gmail.com</a></p>
          </div>

          <form id="fight-form" class="space-y-6">
            <fieldset>
              <legend class="fld-label mb-3">Which division? *</legend>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {DIVISIONS.map((d, i) => (
                  <label class="div-opt">
                    <input type="radio" name="division" value={d.value} required={i === 0} class="sr-only" />
                    <span class="div-card">
                      <span class="cond text-3xl uppercase text-batl-bone leading-none">{d.title}</span>
                      <span class="text-batl-bone/60 text-xs mt-1">{d.desc}</span>
                    </span>
                  </label>
                ))}
              </div>
              <p class="text-batl-bone/40 text-sm mt-3">Not sure? Pick the closest one and tell us your experience below. We'll help you choose.</p>
            </fieldset>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="f-name" class="fld-label">Full name *</label>
                <input id="f-name" type="text" name="name" required placeholder="Fighter's full name" class="fld" />
              </div>
              <div>
                <label for="f-email" class="fld-label">Email *</label>
                <input id="f-email" type="email" name="email" required placeholder="your@email.com" class="fld" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="f-phone" class="fld-label">Phone number *</label>
                <input id="f-phone" type="tel" name="phone" required placeholder="04xx xxx xxx" class="fld" />
              </div>
              <div>
                <label for="f-age" class="fld-label">Age *</label>
                <input id="f-age" type="number" name="age" required min="6" max="99" placeholder="e.g. 24" class="fld" />
              </div>
            </div>

            <div>
              <label for="f-weight" class="fld-label">Weight (kg) *</label>
              <input id="f-weight" type="number" name="weight" required min="15" max="200" step="0.5" placeholder="e.g. 28 for kids, 75 for adults" class="fld" />
            </div>

            <div>
              <label for="f-gym" class="fld-label">Current gym / club</label>
              <input id="f-gym" type="text" name="gym" placeholder="e.g. Soul Lab Gym, Townsville" class="fld" />
            </div>

            <div>
              <label for="f-exp" class="fld-label">Training experience *</label>
              <select id="f-exp" name="trainingExperience" required class="fld appearance-none">
                <option value="" disabled selected>How long have you been training?</option>
                <option value="Under 6 months">Under 6 months</option>
                <option value="6–12 months">6–12 months</option>
                <option value="1–2 years">1–2 years</option>
                <option value="2–4 years">2–4 years</option>
                <option value="4+ years">4+ years</option>
              </select>
            </div>

            <fieldset>
              <legend class="fld-label mb-3">Fight experience *</legend>
              <p class="text-batl-bone/40 text-sm mb-4">Select all that apply. First-timer? Tick "No fight experience yet".</p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {['Muay Thai', 'Other', 'No fight experience yet'].map((d) => (
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="disciplines" value={d} class="w-4 h-4" style="accent-color:#6CC6FF" />
                    <span class="text-batl-bone/70 text-sm">{d}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="f-fights" class="fld-label">Approximate number of fights</label>
              <select id="f-fights" name="numFights" class="fld appearance-none">
                <option value="" selected>Select an option</option>
                <option value="0 — First fight">0 — First fight</option>
                <option value="1–5 fights">1–5 fights</option>
                <option value="6–15 fights">6–15 fights</option>
                <option value="16–30 fights">16–30 fights</option>
                <option value="30+ fights">30+ fights</option>
              </select>
            </div>

            <div class="pt-2">
              <button type="submit" id="submit-btn" class="bbtn w-full disabled:opacity-50 disabled:cursor-not-allowed">
                Register My Interest
              </button>
            </div>

            <p class="text-batl-bone/40 text-xs text-center">No commitment yet. We'll reach out with your matchup and how to confirm your spot.</p>
          </form>
        </>
      ) : (
        <div class="panel text-center text-batl-bone/70">Fighter registrations are closed. Spectators are still welcome. See you on the night.</div>
      )}
    </div>
  </section>

  <!-- ═════════ WHAT HAPPENS NEXT ═════════ -->
  <section class="sec sec-alt">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="kicker">After you register</p>
        <h2 class="h2">What happens next</h2>
        <div class="rule-sm"></div>
      </header>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { step: '01', title: 'We review', desc: 'We look at your experience and weight and find you the right division and matchup.' },
          { step: '02', title: 'We contact you', desc: "We'll reach out with your potential matchup, rules and what to bring." },
          { step: '03', title: 'You prepare', desc: 'Train hard. Fight camp support is available at Soul Lab if you need it.' },
          { step: '04', title: 'Fight night', desc: `Weigh in at ${EVENT.weighIn}, first fight at ${EVENT.firstFight}. Coached corners, refereed bouts.` },
        ].map((item) => (
          <div class="text-center" data-reveal>
            <div class="step">{item.step}</div>
            <h3 class="cond text-2xl uppercase text-batl-bone mb-2">{item.title}</h3>
            <p class="text-batl-bone/60 leading-relaxed text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════ CLOSER ═════════ -->
  <section class="closer">
    <div class="duo closer-photo" aria-hidden="true">
      <img src="/photos/batl-winner-hand-raised.jpg" alt="" loading="lazy" style="object-position:center 30%" />
    </div>
    <div class="closer-fade" aria-hidden="true"></div>
    <div class="relative text-center px-4 py-24 sm:py-32" data-reveal>
      <p class="track text-xs sm:text-sm text-batl-bone">{EVENT.day} {EVENT.dateNum} {EVENT.month}</p>
      <p class="wordmark wordmark-sm mt-3">BATL</p>
      <div class="rule mx-auto" style="width:min(420px,70vw)"></div>
      <p class="track-wide cond text-lg sm:text-2xl text-batl-bone mt-3">See you at the Lab</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-9">
        {REGISTRATIONS_OPEN && <a href="#register" class="bbtn">Register to fight</a>}
        <a href="/contact" class="bbtn-ghost">Ask a question</a>
      </div>
    </div>
  </section>

  </div>

  <Footer />
</Layout>

<style>
  .batl {
    --ink: #04070D;
    --navy: #08111F;
    --blue: #6CC6FF;
    --bone: #ECE6DA;
    background: var(--ink);
    color: var(--bone);
  }
  .cond { font-family: 'Barlow Condensed', 'Bebas Neue', sans-serif; font-weight: 800; }
  .track { font-family: 'Barlow Condensed', 'Inter', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: .32em; }
  .track-wide { text-transform: uppercase; letter-spacing: .28em; font-weight: 700; }

  /* Wordmark: heavy italic, like the poster */
  .wordmark {
    font-family: 'Barlow', 'Inter', sans-serif; font-style: italic; font-weight: 900;
    font-size: clamp(104px, 24vw, 300px); line-height: .82; letter-spacing: -.01em;
    color: var(--bone); margin: 0; padding-right: .06em;
  }
  .wordmark-sm { font-size: clamp(80px, 16vw, 190px); }
  .rule { height: 5px; background: var(--bone); width: min(760px, 80vw); margin-top: clamp(14px, 2vw, 26px); }

  /* Blue duotone photos */
  .duo { position: relative; overflow: hidden; background: #0a2240; }
  .duo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.12) brightness(1.02); transition: transform .6s; }
  .duo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #4aa8ff 0%, #1d63c2 100%); mix-blend-mode: color; opacity: .95; pointer-events: none; }
  .duo::before { content: ''; position: absolute; inset: 0; background: #071a33; mix-blend-mode: multiply; opacity: .35; z-index: 1; pointer-events: none; }
  /* Plain photos (no tint) — tint is only for photos with text over them (hero, closer) */
